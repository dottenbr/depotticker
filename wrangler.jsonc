{
  // The website: static files from docs/, served by a Cloudflare Worker on depotticker.com.
  // Deploy with `npx wrangler deploy` (account and token come from the environment).
  "name": "depotticker-site",
  "compatibility_date": "2025-06-01",
  "workers_dev": false,
  "assets": { "directory": "./docs", "html_handling": "auto-trailing-slash", "not_found_handling": "404-page" },
  "routes": [
    { "pattern": "depotticker.com", "custom_domain": true },
    { "pattern": "www.depotticker.com", "custom_domain": true }
  ]
}
